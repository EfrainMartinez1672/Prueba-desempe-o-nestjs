# Aplicación
NODE_ENV=development
PORT=3000
API_PREFIX=api/v2
COOKIE_SECURE=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=app
DB_PASSWORD=change-me
DB_DATABASE=app_db
DB_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Autenticación: genera dos secretos diferentes de al menos 32 caracteres
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
REFRESH_SECRET=replace-with-another-random-secret-of-at-least-32-chars
JWT_EXPIRES_IN_SECONDS=900
REFRESH_EXPIRES_IN_SECONDS=604800
